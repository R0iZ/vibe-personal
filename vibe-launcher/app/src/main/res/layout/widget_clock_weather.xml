<?xml version="1.0" encoding="utf-8"?>
<!-- Large clock + weather above the dock. Placed from MainActivity; not focusable. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeWidget"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal|top"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/glass_panel"
    android:paddingStart="36dp"
    android:paddingEnd="36dp"
    android:paddingTop="20dp"
    android:paddingBottom="18dp"
    android:alpha="0"
    android:importantForAccessibility="noHideDescendants">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextClock
            android:id="@+id/homeClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFFFF"
            android:textSize="72sp"
            android:fontFamily="@string/font_regular"
            android:letterSpacing="-0.04"
            android:includeFontPadding="false"
            android:shadowColor="#99000000"
            android:shadowRadius="12" />

        <TextClock
            android:id="@+id/homeAmPm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="14dp"
            android:format12Hour="a"
            android:format24Hour=""
            android:textColor="#B3FFFFFF"
            android:textSize="18sp"
            android:fontFamily="@string/font_regular"
            android:letterSpacing="0.08"
            android:textAllCaps="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/weatherLine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/weatherCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E6FFFFFF"
            android:textSize="18sp"
            android:fontFamily="@string/font_medium"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/weatherTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:fontFamily="@string/font_medium"
            android:includeFontPadding="false" />

        <ImageView
            android:id="@+id/weatherIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/weatherDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="#CCFFFFFF"
            android:textSize="16sp"
            android:fontFamily="@string/font_regular"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/weatherExtras"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/weatherHumidity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@string/font_regular" />

        <TextView
            android:id="@+id/weatherWind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@string/font_regular" />

        <TextView
            android:id="@+id/weatherPressure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@string/font_regular" />
    </LinearLayout>
</LinearLayout>
